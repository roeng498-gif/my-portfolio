# ===== SafeGuard: نموذج متغيرات البيئة =====
# انسخ الملف لـ .env وعدّل القيم. ممنوع ترفع .env على Git.

# ---------- أساسيات ----------
FLASK_ENV=development
SECRET_KEY=put-a-long-random-string-here
# قاعدة البيانات: سيبها فاضية لـ SQLite محلي، أو حط رابط PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:5432/safeguard
COOKIE_SECURE=false
DEFAULT_LANG=ar
ALLOWED_ORIGINS=*

# ---------- الموبايل ----------
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_COOLDOWN=60
OTP_PER_PHONE_DAY=5
OTP_PER_IP_HOUR=10

# ---------- فحص الروابط ----------
# Google Safe Browsing (مجاني): https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
# VirusTotal (مجاني 500/يوم): https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
SF_URLHAUS_ENABLED=1
SCAN_PER_HOUR=60
SCAN_MODES_JSON=

# ---------- فحص التطبيقات ----------
MAX_APK_SIZE_MB=50
APP_SCAN_PER_HOUR=60

# ---------- الربط ----------
MAX_CHILDREN=10
MAX_GUARDIANS=3
INVITE_TTL_HOURS=24
INVITE_PER_DAY=20
CONSENT_VERSION=2026-11-1

# ---------- إشعارات FCM (اختياري) ----------
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# ---------- معلومات ----------
SUPPORT_EMAIL=support@safeguard.app
PRIVACY_URL=
